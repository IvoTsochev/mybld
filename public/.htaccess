<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Let existing files and directories resolve normally.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # SPA fallback so routes like /projects/:id and /sanity/* load the app.
  RewriteRule ^ index.html [L]
</IfModule>
